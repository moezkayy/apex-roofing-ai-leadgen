            }
          }
        }
      },
      "id": "a0190000-0000-4000-8000-000000000000",
      "name": "Fetch homepage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        520
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "https://www.googleapis.com/pagespeedonline/v5/runPagespeed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $('Normalize').item.json.website }}"
            },
            {
              "name": "strategy",
              "value": "mobile"
            },
            {
              "name": "category",
              "value": "performance"
            }
          ]
        },
        "options": {
          "timeout": 90000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 0
            }
          }
        }
      },
      "id": "a0200000-0000-4000-8000-000000000000",
      "name": "PageSpeed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1340,
        520
      ],
      "onError": "continueRegularOutput",
      "notes": "Credential: PageSpeed key (Query Auth, name key, value <API key>)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// @include src/audit.js\n\n// Fetch homepage and PageSpeed keep the item order, so item i matches Normalize item i.\nconst leads = $('Normalize').all();\nconst pages = $('Fetch homepage').all();\nconst speeds = $input.all();\nconst year = new Date().getFullYear();\nreturn leads.map((item, i) => {\n  const lead = item.json;\n  const html = pages[i] && pages[i].json.data;\n  const score = speeds[i] && speeds[i].json.lighthouseResult?.categories?.performance?.score;\n  const pagespeed = typeof score === \"number\" ? Math.round(score * 100) : null;\n  return { json: { lead, signals: auditSite(typeof html === \"string\" ? html : null, lead.website, pagespeed, year) } };\n});"
      },
      "id": "a0210000-0000-4000-8000-000000000000",
      "name": "Audit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a0220000-0000-4000-8000-000000000000",
              "leftValue": "={{ $('Config').first().json.ai }}",
              "rightValue": "claude",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a0230000-0000-4000-8000-000000000000",
      "name": "AI?",
      "type": "n8n-nodes-base.if",
