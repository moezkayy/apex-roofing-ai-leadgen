    {
      "parameters": {
        "jsCode": "// @include src/normalize.js\n// @include src/audit.js\n\n// The sample file is one JSON array; Extract from File puts it under \"data\". One item per place comes out.\nconst cfg = $('Config').first().json;\nconst year = new Date().getFullYear();\nconst places = $input.all().flatMap((i) => (Array.isArray(i.json.data) ? i.json.data : [i.json.data || i.json]));\nreturn places.slice(0, cfg.limit).map((place) => {\n  const lead = normalizePlace(place);\n  const mock = lead.mock || {};\n  return { json: { lead, signals: auditSite(mock.homepageHtml, lead.website, mock.pagespeedMobile, year) } };\n});"
      },
      "id": "a0160000-0000-4000-8000-000000000000",
      "name": "Normalize + audit (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/compass~crawler-google-places/run-sync-get-dataset-items?timeout=300",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ searchStringsArray: [$json.searchTerm], locationQuery: $json.city, maxCrawledPlacesPerSearch: $json.limit, language: \"en\", scrapeContacts: true, maxReviews: 5, reviewsSort: \"newest\", skipClosedPlaces: true }) }}",
        "options": {
          "timeout": 330000
        }
      },
      "id": "a0170000-0000-4000-8000-000000000000",
      "name": "Apify: Google Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        680,
        520
      ],
      "notes": "Credential: Apify token (Header Auth, name Authorization, value Bearer <token>)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// @include src/normalize.js\n\nconst cfg = $('Config').first().json;\nreturn $input.all().slice(0, cfg.limit).map((i) => ({ json: normalizePlace(i.json) }));"
      },
      "id": "a0180000-0000-4000-8000-000000000000",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        520
      ]
    },
    {
