    {
      "parameters": {
        "jsCode": "// @include src/prompt.js\n\nconst cfg = $('Config').first().json;\nreturn $input.all().map((i) => ({\n  json: { ...i.json, request: buildClaudeRequest(i.json.lead, i.json.signals, cfg) },\n}));"
      },
      "id": "a0240000-0000-4000-8000-000000000000",
      "name": "Build Claude request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "a0250000-0000-4000-8000-000000000000",
      "name": "Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2260,
        100
      ],
      "onError": "continueRegularOutput",
      "notes": "Credential: Anthropic key (Anthropic account credential)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// @include src/prompt.js\n// @include src/mock_ai.js\n\n// Claude keeps the item order, so reply i belongs to request i. A failed call falls back to the template.\nconst cfg = $('Config').first().json;\nconst sent = $('Build Claude request').all();\nreturn $input.all().map((reply, i) => {\n  const { lead, signals } = sent[i].json;\n  const parsed = parseClaudeResponse(reply.json);\n  const ai = parsed.ai || { ...mockAi(lead, signals, cfg), aiSource: \"template (fallback)\" };\n  return { json: { lead, signals, ai, usage: parsed.usage } };\n});"
      },
      "id": "a0260000-0000-4000-8000-000000000000",
      "name": "Parse Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// @include src/mock_ai.js\n\nconst cfg = $('Config').first().json;\nreturn $input.all().map((i) => ({\n  json: { lead: i.json.lead, signals: i.json.signals, ai: mockAi(i.json.lead, i.json.signals, cfg), usage: { inputTokens: 0, outputTokens: 0 } },\n}));"
      },
      "id": "a0270000-0000-4000-8000-000000000000",
      "name": "Mock AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2040,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// @include src/score.js\n\nconst year = new Date().getFullYear();\nreturn $input.all().map((i) => {\n  const { lead, signals, ai, usage } = i.json;\n  const { score, tier, scoreReasons } = scoreLead(lead, signals, ai, year);\n  return { json: { ...lead, signals, ...ai, usage, score, tier, scoreReasons } };\n});"
      },
      "id": "a0280000-0000-4000-8000-000000000000",
      "name": "Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// @include src/output.js\n\nconst cfg = $('Config').first().json;\nconst { json, csv } = buildOutput($input.all().map((i) => i.json), {\n  agency: cfg.agencyName,\n  niche: cfg.searchTerm,\n  city: cfg.city,\n  dataSource: cfg.dataSource,\n  ai: cfg.ai,\n  model: cfg.model,\n  generatedAt: new Date().toISOString(),\n  durationSeconds: (Date.now() - new Date(cfg.startedAt).getTime()) / 1000,\n});\nreturn [{ json: { jsonText: JSON.stringify(json, null, 2) + \"\\n\", csv } }];"
      },
